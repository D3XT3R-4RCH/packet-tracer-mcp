# =====================================================================
# OPSEC & ANTI-OSINT (Credenciales, Entornos, Trazas Locales)
# =====================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*secret*
*credentials*
*token*

# Archivos y logs que puedan exponer rutas locales, usuarios o IPs
*.log
logs/
traces/
dumps/
crash_reports/

# =====================================================================
# CISCO PACKET TRACER (Topologías locales, sesiones y cachés con metadatos)
# =====================================================================
*.pkt
*.pkz
*.pka
*.pks
!examples/*.pkt
pt_cache/
ipc_session/

# =====================================================================
